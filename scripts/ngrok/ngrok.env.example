# Copie para scripts/ngrok/ngrok.env e ajuste (ngrok.env está no .gitignore).
#
# Produção sem depender do Mac: hospede a API na nuvem/VPS e use API_BASE_URL
# permanente no app — não ngrok no portátil (ver README.md).
#
# Autenticação: uma vez por máquina — não coloque token aqui se já usou:
#   ngrok config add-authtoken SEU_TOKEN
#
# Porta do backend local que o túnel expõe na internet:
NGROK_PORT=65432

# Opcional: domínio reservado ngrok (normalmente plano pago).
# Se ficar em branco, o ngrok gera URL nova a cada sessão — atualize API_BASE_URL no app.
# NGROK_DOMAIN=seu-subdominio.ngrok-free.dev

# Segundos antes de tentar de novo após queda (mínimo 2):
# NGROK_RESTART_MIN=2
# NGROK_RESTART_MAX=120
