# Copiar para `.env` na raiz. Chaves Firebase = projeto pulseflow-f9154 (histórico pré-refactor).
# Sobrescreve os defaults em `lib/config/app_config.dart` quando preenchidas.

USE_FIREBASE=true

# Opcional: projeto/ apps (defaults já batem com pulseflow-f9154)
# FIREBASE_PROJECT_ID=pulseflow-f9154
# FIREBASE_MESSAGING_SENDER_ID=1046085330534
# FIREBASE_STORAGE_BUCKET=pulseflow-f9154.firebasestorage.app
# FIREBASE_AUTH_DOMAIN=pulseflow-f9154.firebaseapp.com

# Web
# FIREBASE_WEB_API_KEY=
# FIREBASE_WEB_APP_ID=

# Android
# FIREBASE_ANDROID_API_KEY=
# FIREBASE_ANDROID_APP_ID=

# iOS — o bundle tem de ser o mesmo do Xcode E da app iOS no Console Firebase.
# Se PRODUCT_BUNDLE_IDENTIFIER = com.henriqueribeiro.pulseflow.app, regista essa app no Firebase
# (ou usa flutterfire configure) e coloca aqui o Google App ID / API Key dessa app.
# FIREBASE_IOS_BUNDLE_ID=com.henriqueribeiro.pulseflow.app
# FIREBASE_IOS_API_KEY=
# FIREBASE_IOS_APP_ID=
